---
import Layout from '../../layouts/Layout.astro';
import BackgroundInputs from '../../components/BackgroundInputs.astro';
import GridInputs from '../../components/GridInputs.astro';
import ImportUrl from '../../components/ImportUrl.astro';
---

<Layout title="Generate Speech to Text URL - Neuro Exercises">
    <main class="min-h-screen bg-background py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
            <h1 class="text-4xl font-bold text-foreground mb-2">Generate Speech to Text URL</h1>
            <p class="text-muted-foreground mb-8">Configure your speech exercise and generate a shareable URL.</p>

            <div class="bg-card border border-border rounded-xl p-6 mb-8 shadow-sm">
                <form id="urlForm" class="space-y-6">
                    <div>
                        <h3 class="text-lg font-semibold text-foreground mb-4">Speech Settings</h3>

                        <div class="mb-4">
                            <label class="block text-sm font-medium text-foreground mb-2" for="speechLanguageSelect">
                                Recognition Language
                            </label>
                            <select id="speechLanguageSelect" class="w-full px-4 py-2 bg-secondary border border-border rounded-lg text-foreground">
                                <option value="en-US">English (US)</option>
                                <option value="en-GB">English (UK)</option>
                                <option value="pt-BR">Portuguese (Brazil)</option>
                                <option value="pt-PT">Portuguese (Portugal)</option>
                                <option value="es-ES">Spanish (Spain)</option>
                                <option value="fr-FR">French</option>
                                <option value="de-DE">German</option>
                                <option value="it-IT">Italian</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="block text-sm font-medium text-foreground mb-2" for="correctAnswersInput">
                                Correct Answer(s) (comma-separated)
                            </label>
                            <input
                                    id="correctAnswersInput"
                                    type="text"
                                    class="w-full px-4 py-2 bg-secondary border border-border rounded-lg text-foreground"
                                    placeholder="hello, banana, start"
                            />
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                            <div>
                                <label class="block text-sm font-medium text-foreground mb-2" for="micPositionSelect">
                                    Microphone Button Position
                                </label>
                                <select id="micPositionSelect" class="w-full px-4 py-2 bg-secondary border border-border rounded-lg text-foreground">
                                    <option value="bottom-center" selected>Bottom Center</option>
                                    <option value="bottom-left">Bottom Left</option>
                                    <option value="bottom-right">Bottom Right</option>
                                    <option value="top-right">Top Right</option>
                                    <option value="top-left">Top Left</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-foreground mb-2" for="clearPositionSelect">
                                    Clear Button Position
                                </label>
                                <select id="clearPositionSelect" class="w-full px-4 py-2 bg-secondary border border-border rounded-lg text-foreground">
                                    <option value="bottom-right" selected>Bottom Right</option>
                                    <option value="bottom-left">Bottom Left</option>
                                    <option value="top-right">Top Right</option>
                                    <option value="top-left">Top Left</option>
                                </select>
                            </div>
                        </div>

                        <div class="space-y-3">
                            <label class="flex items-center gap-2">
                                <input type="checkbox" id="continuousCheck" checked class="text-primary" />
                                <span class="text-foreground font-medium">Continuous Listening</span>
                            </label>
                            <label class="flex items-center gap-2">
                                <input type="checkbox" id="autoStartCheck" class="text-primary" />
                                <span class="text-foreground font-medium">Auto-start on page load</span>
                            </label>
                            <label class="flex items-center gap-2">
                                <input type="checkbox" id="hideLiveTranscriptCheck" class="text-primary" />
                                <span class="text-foreground font-medium">Hide Live Transcript Bubble</span>
                            </label>
                            <label class="flex items-center gap-2">
                                <input type="checkbox" id="hideResultsPopupCheck" class="text-primary" />
                                <span class="text-foreground font-medium">Hide Results Popup</span>
                            </label>
                        </div>
                    </div>

                    <hr class="my-4 h-0.5 bg-border" />
                    <BackgroundInputs />

                    <hr class="my-4 h-0.5 bg-border" />
                    <GridInputs />
                </form>
            </div>

            <ImportUrl exercise="Speech to Text" />

            <div id="resultSection" class="bg-card border border-border rounded-xl p-6 mt-8">
                <h2 class="text-xl font-bold text-foreground mb-4">Generated URL</h2>
                <div class="bg-secondary rounded-lg p-4 mb-4 overflow-x-auto">
                    <code id="generatedUrl" class="text-sm text-foreground break-all"></code>
                </div>
                <div class="flex gap-4">
                    <button id="copyBtn" class="px-6 py-2 bg-primary text-primary-foreground rounded-lg font-medium hover:opacity-90 transition-opacity">
                        Copy URL
                    </button>
                    <button id="openBtn" class="px-6 py-2 bg-secondary text-secondary-foreground rounded-lg font-medium hover:bg-accent transition-colors">
                        Open Exercise
                    </button>
                </div>
            </div>
        </div>
    </main>

    <script>
        import { WebviewWindow } from "@tauri-apps/api/webviewWindow";
        import { isRunningInTauri } from "../../utils/IsTauri.js";
        const windowTauri = await isRunningInTauri();

        let currentPlatform = "web";
        if (windowTauri) {
            const os = await import("@tauri-apps/plugin-os");
            currentPlatform = os.platform();
        }

        const openBtn = document.getElementById('openBtn');
        const generatedUrlEl = document.getElementById('generatedUrl');

        openBtn.addEventListener("click", (e) => {
            e.preventDefault();

            const url = generatedUrlEl.textContent.trim();
            if (!url) return;

            if (windowTauri && currentPlatform !== "android" && currentPlatform !== "ios") {
                const label = `textRecognition-${Date.now()}`;
                const win = new WebviewWindow(label, { url });

                win.once("tauri://created", () => {
                    console.log("Text Recognition window created");
                });
                win.once("tauri://error", (e) => {
                    console.error("Window creation error:", e);
                });
            } else {
                window.open(url, '_blank', 'noopener,noreferrer');
            }
        });
    </script>
    <script src="../../scripts/SpeechToTextGenerateScript.js"></script>
</Layout>